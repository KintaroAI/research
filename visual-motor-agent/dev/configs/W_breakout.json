{
  "name": "W_breakout",
  "description": "Task 00132: the Breakout court to watch. U_breakout.json's court with the paddle given to a script (env.auto_lag = 6: it follows the ball as it was 6 ticks ago and returns about .80 of the balls); a hit lowers the body's hunger to 0 and a miss adds .5, as in the court the agent plays: that is the score to predict. The model is the default agent's (U_agent.json) without the label, and it only watches (online.watch): no instinct, the null move every tick.",
  "env": {
    "kind": "breakout",
    "size": 64,
    "wall": 2,
    "paddle_w": 12,
    "paddle_h": 2,
    "paddle_y": 60,
    "paddle_speed": 4.5,
    "ball": 2,
    "ball_speed": 1.5,
    "max_angle": 60.0,
    "serve_angle": 45.0,
    "pause": 8,
    "h_rate": 0.001,
    "h_relief": 1.0,
    "miss_add": 0.5,
    "drives": true,
    "respawn": true,
    "gray": true,
    "auto_lag": 6
  },
  "model": {
    "uni_chan": 1,
    "patch": 8,
    "universal": 1,
    "bins": 32,
    "gray": 1,
    "ctx": 8,
    "in_bins": 1,
    "uni_pyr": 3,
    "sum_thumb": 1,
    "band_n": 4,
    "band_cols": 2,
    "age_key": 1,
    "img": 64,
    "band_win": 1,
    "n_layer": 8
  },
  "online": {
    "actor": "self",
    "steps": 60000,
    "batch": 8,
    "replay": 100000,
    "explore_eps": 0.0,
    "goal": 0,
    "memory": "gated",
    "stm": 256,
    "relief_k": 12,
    "store_relief": 0,
    "store_surprise": 0.0,
    "store_base": 1.0,
    "store_warmup": 1000,
    "instinct_m": 0,
    "device": "cuda",
    "save_every": 10000,
    "log_every": 1000,
    "threads": 4,
    "pieces": 1,
    "piece_rule": "mean",
    "ring": 1,
    "watch": 1
  },
  "ppo": {
    "use_ppo": 0,
    "epochs": 1,
    "minibatches": 1,
    "lr": 0.0003
  }
}